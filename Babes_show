<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="referrer" content="no-referrer">
    <title>Gallery Studio</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <style>
      :root {
        --bg-color: #ffffff;
        --sidebar-bg: #ffffff;
        --card-bg: #f8fafc;
        --card-border: rgba(0, 0, 0, 0.08);
        --text-color: #0f172a;
        --text-muted: #64748b;
        --control-bg: rgba(0, 0, 0, 0.04);
        --control-hover: rgba(0, 0, 0, 0.08);
        --header-bg: rgba(255, 255, 255, 0.95);
        --tick-bg: rgba(255, 255, 255, 0.85);
        --tick-border: rgba(0, 0, 0, 0.2);
        --action-btn-bg: rgba(255, 255, 255, 0.9);
        
        --accent-grad: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #6366f1 100%);
        --accent-glow: rgba(99, 102, 241, 0.25);
        --pink-fav: linear-gradient(135deg, #f43f5e 0%, #fb7185 100%);
        --danger-grad: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        
        --card-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.1);

        /* Configurable Transition Duration */
        --transition-speed: 0.42s;
        --transition-easing: cubic-bezier(0.25, 1, 0.5, 1);
      }

      [data-theme="dark"] {
        --bg-color: #0b0f19;
        --sidebar-bg: #111827;
        --card-bg: #1f2937;
        --card-border: rgba(255, 255, 255, 0.08);
        --text-color: #f8fafc;
        --text-muted: #94a3b8;
        --control-bg: rgba(255, 255, 255, 0.06);
        --control-hover: rgba(255, 255, 255, 0.12);
        --header-bg: rgba(11, 15, 25, 0.92);
        --tick-bg: rgba(31, 41, 55, 0.85);
        --tick-border: rgba(255, 255, 255, 0.2);
        --action-btn-bg: rgba(31, 41, 55, 0.9);
        
        --card-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.4);
      }

      * {
        box-sizing: border-box;
      }

      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        margin: 0;
        background-color: var(--bg-color);
        color: var(--text-color);
        display: flex;
        height: 100vh;
        overflow: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .sidebar {
        width: 280px;
        background: var(--sidebar-bg);
        border-right: 1px solid var(--card-border);
        padding: 28px 20px;
        display: flex;
        flex-direction: column;
        gap: 24px;
        flex-shrink: 0;
        transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), margin-right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1050;
        overflow-y: auto;
      }

      .sidebar.collapsed {
        transform: translateX(-100%);
        margin-right: -280px;
      }

      .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        -webkit-backdrop-filter: blur(4px);
        backdrop-filter: blur(4px);
        z-index: 1040;
      }

      @media (max-width: 768px) {
        .sidebar {
          position: fixed;
          top: 0;
          bottom: 0;
          left: 0;
          box-shadow: 10px 0 35px rgba(0,0,0,0.3);
        }
        .sidebar.collapsed {
          transform: translateX(-100%);
          margin-right: 0;
        }
        .sidebar-backdrop.active {
          display: block;
        }
      }

      .app-brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .app-brand-logo {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: var(--accent-grad);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 20px;
        box-shadow: 0 4px 14px var(--accent-glow);
      }

      .app-brand h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.5px;
        background: var(--accent-grad);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
      }

      .sidebar-group {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      
      .sidebar-group-title {
        font-size: 11px;
        text-transform: uppercase;
        color: var(--text-muted);
        font-weight: 700;
        letter-spacing: 1px;
      }

      .search-wrapper {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
      }

      .search-wrapper input {
        width: 100%;
        padding-right: 32px;
      }

      .search-clear-btn {
        position: absolute;
        right: 10px;
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        font-size: 14px;
        line-height: 1;
        display: none;
        padding: 4px;
        border-radius: 50%;
      }

      .search-clear-btn:hover {
        color: var(--text-color);
      }

      .theme-switch-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }

      .theme-switch-btn {
        background: var(--control-bg);
        border: 1px solid var(--card-border);
        color: var(--text-color);
        padding: 8px 12px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.2s ease;
      }

      .theme-switch-btn.active {
        background: var(--accent-grad);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 2px 10px var(--accent-glow);
      }

      .main-content {
        flex: 1;
        overflow-y: auto;
        padding: 0 20px 28px 20px;
        min-width: 0;
        position: relative;
        z-index: 1;
        background: var(--bg-color);
      }

      .static-top {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--bg-color);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
        padding: 24px 28px 16px 28px;
        margin-left: -28px;          
        margin-right: -28px;         
        margin-bottom: 20px;
        border-bottom: 1px solid transparent;
        transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.25s ease;
      }

      .static-top.header-hidden {
        transform: translateY(-100%);
      }

      .static-top.header-scrolled {
        border-bottom-color: var(--card-border);
      }

      .header-reveal-btn {
        position: fixed;
        top: 16px;
        left: 50%;
        transform: translateX(-50%) translateY(-80px) scale(0.8);
        z-index: 1060;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1px solid var(--card-border);
        background: var(--sidebar-bg);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        opacity: 0;
        pointer-events: none;
        transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
        user-select: none;
      }

      .header-reveal-btn.visible {
        transform: translateX(-50%) translateY(0) scale(1);
        opacity: 1;
        pointer-events: auto;
      }

      .header-reveal-btn:hover {
        transform: translateX(-50%) translateY(0) scale(1.12);
      }

      header {
        max-width: 1440px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .app-title {
        margin: 0;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -0.5px;
        background: var(--accent-grad);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
      }

      .image-stats {
        font-size: 13px;
        color: var(--text-color);
        background: var(--control-bg);
        padding: 10px 14px;
        border-radius: 10px;
        border: 1px solid var(--card-border);
        font-weight: 600;
        display: block;
        text-align: center;
      }

      .toolbar {
        max-width: 1440px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .toolbar-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
      }

      .toolbar-group {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }

      .input-control {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        background: var(--control-bg);
        border: 1px solid var(--card-border);
        color: var(--text-color);
        padding: 10px 16px;
        border-radius: 12px;
        font-size: 14px;
        font-family: inherit;
        outline: none;
        transition: all 0.25s ease;
      }

      select.input-control {
        padding-right: 32px;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 10px center;
        background-size: 14px;
      }

      [data-theme="dark"] select.input-control {
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
      }

      .input-control:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
      }

      .btn {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        background: var(--control-bg);
        border: 1px solid var(--card-border);
        color: var(--text-color);
        padding: 10px 16px;
        border-radius: 12px;
        font-size: 14px;
        font-family: inherit;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        user-select: none;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .btn-icon {
        padding: 10px 14px;
        font-size: 16px;
      }

      .sidebar .btn {
        width: 100%;
        justify-content: center;
      }

      .btn:hover:not(:disabled) {
        transform: translateY(-2px);
      }

      .btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }

      .btn-accent {
        background: var(--accent-grad);
        border: none;
        color: #ffffff;
        box-shadow: 0 4px 15px var(--accent-glow);
      }

      .btn-accent:hover:not(:disabled) {
        opacity: 0.95;
      }

      .btn-toggle.active {
        background: var(--pink-fav);
        border-color: transparent;
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(244, 63, 94, 0.35);
      }

      .btn-danger {
        background: var(--danger-grad);
        border-color: transparent;
        color: #ffffff;
      }

      .action-group-selected {
        display: none;
        gap: 10px;
        align-items: center;
      }

      .action-group-selected.active {
        display: inline-flex;
      }

      .classic-blue-tick {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 2px solid var(--tick-border);
        background: var(--tick-bg);
        -webkit-backdrop-filter: blur(4px);
        backdrop-filter: blur(4px);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        user-select: none;
        color: transparent;
        font-size: 14px;
        font-weight: 800;
        pointer-events: auto;
        transition: all 0.2s ease;
      }

      .classic-blue-tick.selected {
        background: #4f46e5;
        border-color: #4f46e5;
        color: #ffffff;
      }

      .classic-blue-tick:hover {
        transform: scale(1.1);
      }

      .masonry-grid {
        column-count: 4;
        column-gap: 20px;
        max-width: 1440px;
        margin: 0 auto;
      }

      @media (max-width: 1400px) { .masonry-grid { column-count: 3; } }
      @media (max-width: 900px)  { .masonry-grid { column-count: 2; } }
      @media (max-width: 600px)  { .masonry-grid { column-count: 1; } }

      .masonry-item {
        position: relative;
        display: inline-block;
        width: 100%;
        break-inside: avoid;
        -webkit-column-break-inside: avoid;
        page-break-inside: avoid;
        margin-bottom: 20px;
        background: var(--card-bg);
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--card-border);
        box-shadow: var(--card-shadow);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        vertical-align: top;
      }

      .masonry-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.2);
      }

      .masonry-item.selected {
        outline: 3px solid #6366f1;
      }

      .masonry-item img {
        width: 100%;
        height: auto;
        display: block;
        min-height: 120px;
        background: var(--control-bg);
      }

      .card-overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 14px;
        background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, transparent 40%, transparent 60%, rgba(0,0,0,0.5) 100%);
      }

      .overlay-top, .overlay-bottom {
        display: flex;
        align-items: center;
      }

      .overlay-top {
        justify-content: space-between;
      }

      .overlay-bottom {
        justify-content: flex-end;
      }

      .card-overlay .classic-blue-tick, 
      .card-overlay .action-btn {
        opacity: 0;
        transform: translateY(4px);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .masonry-item:hover .classic-blue-tick,
      .masonry-item:hover .action-btn,
      .masonry-item.selected .classic-blue-tick,
      .masonry-item.selected .action-btn,
      .masonry-item.buttons-pinned .classic-blue-tick,
      .masonry-item.buttons-pinned .action-btn {
        opacity: 1;
        transform: translateY(0);
      }

      .action-btn {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        background: var(--action-btn-bg);
        border: 1px solid var(--card-border);
        color: var(--text-color);
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 15px;
        font-family: inherit;
        pointer-events: auto;
        transition: all 0.2s ease;
      }

      .action-btn:hover {
        transform: scale(1.1);
      }

      .action-btn.info-btn {
        font-weight: 800;
        font-family: serif;
        font-size: 17px;
      }

      .action-btn.fav-btn.active {
        opacity: 1;
        background: var(--pink-fav);
        border-color: transparent;
        color: #ffffff;
      }

      /* OVERLAY INFO & TAG INTERFACE */
      .overlay-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.7);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
        z-index: 1200;
        align-items: center;
        justify-content: center;
        padding: 20px;
        animation: fadeIn 0.2s ease;
      }
      .overlay-modal.open {
        display: flex;
      }
      .overlay-modal-card {
        background: var(--sidebar-bg);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        width: 100%;
        max-width: 520px;
        padding: 26px;
        box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.35);
        display: flex;
        flex-direction: column;
        gap: 20px;
        max-height: 85vh;
        overflow-y: auto;
      }
      .overlay-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .overlay-title {
        font-size: 20px;
        font-weight: 800;
        background: var(--accent-grad);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
      }
      .overlay-close-btn {
        background: var(--control-bg);
        border: 1px solid var(--card-border);
        color: var(--text-color);
        width: 32px;
        height: 32px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
      }
      .overlay-copy-row {
        display: flex;
        gap: 10px;
      }
      .overlay-copy-row input {
        flex: 1;
        min-width: 0;
        font-size: 15px;
        padding: 12px 16px;
      }
      .overlay-copy-row button {
        font-size: 15px;
        padding: 12px 20px;
      }
      .tags-section-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .tags-container {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
      }
      .tag-badge {
        font-size: 14px;
        font-weight: 600;
        padding: 8px 14px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--control-bg);
        color: var(--text-color);
        border: 1px solid var(--card-border);
        box-shadow: none;
      }
      .tag-remove {
        cursor: pointer;
        font-weight: 800;
        font-size: 16px;
        opacity: 0.6;
        transition: opacity 0.2s, color 0.2s;
      }
      .tag-remove:hover {
        opacity: 1;
        color: #ef4444;
      }
      .add-tag-btn {
        background: var(--accent-grad);
        color: #ffffff;
        border: 1px solid var(--card-border);
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: none;
        transition: background 0.2s ease, transform 0.2s ease;
      }
      .add-tag-btn:hover {
        background: var(--control-hover);
        transform: translateY(-1px);
      }
      .add-tag-btn svg {
        width: 16px;
        height: 16px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.5;
      }

      #sidebarTags {
        max-height: 200px;
        overflow-y: auto;
      }

      .sidebar-tag {
        background: var(--control-bg);
        border: 1px solid var(--card-border);
        color: var(--text-color);
        padding: 6px 10px;
        border-radius: 12px;
        font-size: 14px;
        cursor: pointer;
        user-select: none;
      }
      .sidebar-tag.active {
        background: var(--pink-fav);
        color: #fff;
      }

      .notification {
        position: fixed;
        bottom: 28px;
        right: 28px;
        background: #0f172a;
        color: #ffffff;
        padding: 10px 18px;
        border-radius: 12px;
        box-shadow: 0 12px 35px rgba(0,0,0,0.25);
        z-index: 1300;
        display: none;
        align-items: center;
        max-width: 420px;
        animation: slideUp 0.25s ease forwards;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .notification-text {
        font-size: 13px;
        font-weight: 500;
        word-break: break-all;
      }

      .notification-text.small-url {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 11px;
        color: #cbd5e1;
        line-height: 1.4;
      }

      @keyframes slideUp {
        from { transform: translateY(16px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      .modal, .confirm-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background-color: rgba(15, 23, 42, 0.92);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
        z-index: 1100;
        justify-content: center;
        align-items: center;
        padding: 24px;
        touch-action: none;
      }

      .modal.open, .confirm-overlay.open {
        display: flex;
      }

      .modal-slideshow-bar {
        position: absolute;
        top: 24px;
        left: 32px;
        display: flex;
        align-items: center;
        gap: 8px;
        height: 46px;
        z-index: 1120;
        background: rgba(15, 23, 42, 0.65);
        -webkit-backdrop-filter: blur(16px);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.16);
        padding: 0 10px;
        border-radius: 40px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
        transition: opacity 0.25s ease, transform var(--transition-speed) var(--transition-easing);
      }

      .modal-slideshow-bar.hidden {
        opacity: 0;
        pointer-events: none;
        transform: translateY(-10px);
      }

      .modal-control-btn-icon {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
