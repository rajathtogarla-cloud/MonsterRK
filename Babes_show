      function toggleFavorite(item, recordHistory = true) {
        const isFav = favorites.has(item.url);
        const newFavStatus = !isFav;

        if (newFavStatus) {
          favorites.add(item.url);
          showNotification('Added to favorites');
        } else {
          favorites.delete(item.url);
          showNotification('Removed from favorites');
        }

        if (recordHistory) {
          pushToHistory({
            type: 'favorite',
            url: item.url,
            item: item,
            previousState: isFav,
            newState: newFavStatus
          });
        }

        renderGallery();

        try {
          const patchUrl = `https://firestore.googleapis.com/v1/${item.id}?updateMask.fieldPaths=favorite&key=${API_KEY}`;
          fetch(patchUrl, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fields: { favorite: { booleanValue: newFavStatus } } })
          });
        } catch (error) { }
      }

      deleteSelectedBtn.addEventListener('click', () => {
        const count = selectedUrls.size;
        if (count === 0) return;
        confirmTitle.textContent = `Delete ${count} Image${count > 1 ? 's' : ''}?`;
        confirmOverlay.classList.add('open');
      });

      confirmDeleteBtn.addEventListener('click', async () => {
        const itemsToDelete = allImages.filter(img => selectedUrls.has(img.url));
        
        pushToHistory({
          type: 'delete',
          items: [...itemsToDelete]
        });
        
        allImages = allImages.filter(img => !selectedUrls.has(img.url));
        selectedUrls.forEach(url => favorites.delete(url));
        selectedUrls.clear();
        
        confirmOverlay.classList.remove('open');
        renderGallery();
        showNotification('Removing selected items...');

        const deletePromises = itemsToDelete.map(item => {
          if (item.id) {
            const deleteUrl = `https://firestore.googleapis.com/v1/${item.id}?key=${API_KEY}`;
            return fetch(deleteUrl, { method: 'DELETE' });
