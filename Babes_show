        const visibleTags = new Set();
        visibleItems.forEach(item => {
          (item.tags || []).forEach(t => visibleTags.add(t));
        });

        // Ensure currently active tags stay in the list even while toggled
        activeTagFilters.forEach(t => visibleTags.add(t));

        // Sort alphabetically and apply search query filter
        const sortedTags = Array.from(visibleTags)
          .filter(tag => !query || tag.toLowerCase().includes(query))
          .sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));

        if (sortedTags.length === 0) {
          sidebarTagsContainer.innerHTML = '<span style="font-size: 12px; color: var(--text-muted);">No matching tags</span>';
          return;
        }
        
        sortedTags.forEach(tag => {
          const tagEl = document.createElement('div');
          tagEl.className = `sidebar-tag ${activeTagFilters.has(tag) ? 'active' : ''}`;
          tagEl.textContent = tag;
          tagEl.addEventListener('click', () => {
            if (activeTagFilters.has(tag)) {
              activeTagFilters.delete(tag);
            } else {
              activeTagFilters.add(tag);
            }
            renderGallery();
            renderSidebarTags();
          });
          sidebarTagsContainer.appendChild(tagEl);
        });
      }

      function getVisibleImages() {
        const query = searchInput.value.trim().toLowerCase();

        return allImages
          .filter(item => {
            if (showFavoritesOnly && !favorites.has(item.url)) return false;
            
            if (activeTagFilters.size > 0) {
              const itemTags = item.tags || [];
              const hasAllActiveTags = Array.from(activeTagFilters).every(t => itemTags.includes(t));
              if (!hasAllActiveTags) return false;
            }

            if (!query) return true;
            const matchName = item.name && item.name.toLowerCase().includes(query);
            const matchUrl = item.url && item.url.toLowerCase().includes(query);
            const matchTag = item.tags && item.tags.some(t => t.toLowerCase().includes(query));
            return matchName || matchUrl || matchTag;
          })
          .sort((a, b) => {
            if (sortSelect.value === 'newest') return b.originalIndex - a.originalIndex;
            return a.originalIndex - b.originalIndex;
          });
      }

      async function updateFirestoreTags(item) {
        try {
          const patchUrl = `https://firestore.googleapis.com/v1/${item.id}?updateMask.fieldPaths=tags&key=${API_KEY}`;
          await fetch(patchUrl, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              fields: { 
                tags: { arrayValue: { values: item.tags.map(t => ({ stringValue: t })) } } 
              } 
            })
          });
        } catch (error) {
          showNotification('Error saving tag data');
        }
      }

