      importJsonBtn.addEventListener('click', () => importFileInput.click());
      
      importFileInput.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = async (event) => {
          try {
            const data = JSON.parse(event.target.result);
            if (!Array.isArray(data)) throw new Error("Format invalid");
            showNotification(`Syncing ${data.length} files...`, false, 4000);
            
            for (const item of data) {
              const url = item.url || item;
              if (typeof url !== 'string' || !url.startsWith('http')) continue;
              
              const isFav = item.favorite === true;
              const firestorePayload = {
                fields: {
                  str: { stringValue: url },
                  date: { timestampValue: new Date().toISOString() },
                  favorite: { booleanValue: isFav },
                  tags: { arrayValue: { values: [{ stringValue: DEFAULT_TAG }] } }
                }
              };

              await fetch(`${FIRESTORE_BASE}?key=${API_KEY}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(firestorePayload)
              });
            }
            
            showNotification('Sync complete!');
            setTimeout(() => window.location.reload(), 1000);
          } catch (err) {
            showNotification('Could not parse JSON archive.');
          }
        };
        reader.readAsText(file);
        e.target.value = '';
      });

      undoBtn.addEventListener('click', async () => {
        if (currentHistoryIndex < 0) return;
        const action = actionHistory[currentHistoryIndex];
        
        if (action.type === 'delete') {
          showNotification('Restoring images...');
          currentHistoryIndex--;
          updateHistoryButtons();

          const restoredItems = [];
          for (const item of action.items) {
            const isFav = favorites.has(item.url);
            const firestorePayload = {
              fields: {
                str: { stringValue: item.url },
                date: { timestampValue: new Date().toISOString() },
                favorite: { booleanValue: isFav },
                tags: { arrayValue: { values: (item.tags || [DEFAULT_TAG]).map(t => ({ stringValue: t })) } }
              }
            };

            try {
              const res = await fetch(`${FIRESTORE_BASE}?key=${API_KEY}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(firestorePayload)
              });
              const data = await res.json();
              
              const restored = { ...item, id: data.name };
              restoredItems.push(restored);
              allImages.push(restored);
            } catch (e) {
              restoredItems.push(item);
              allImages.push(item);
            }
          }

          action.items = restoredItems;
          renderGallery();
        } else if (action.type === 'favorite') {
          if (action.previousState) {
            favorites.add(action.url);
          } else {
            favorites.delete(action.url);
          }
          currentHistoryIndex--;
          updateHistoryButtons();
          renderGallery();

          const currentDoc = allImages.find(img => img.url === action.url) || action.item;
          if (currentDoc && currentDoc.id) {
            try {
              fetch(`https://firestore.googleapis.com/v1/${currentDoc.id}?updateMask.fieldPaths=favorite&key=${API_KEY}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ fields: { favorite: { booleanValue: action.previousState } } })
              });
            } catch (e) {}
          }
        }
      });

      redoBtn.addEventListener('click', async () => {
        if (currentHistoryIndex >= actionHistory.length - 1) return;
        currentHistoryIndex++;
        const action = actionHistory[currentHistoryIndex];

        if (action.type === 'delete') {
          showNotification('Redoing delete...');
          const urlsToRemove = new Set(action.items.map(i => i.url));
          
          allImages = allImages.filter(img => !urlsToRemove.has(img.url));
          urlsToRemove.forEach(url => favorites.delete(url));
          selectedUrls.clear();
          updateHistoryButtons();
          renderGallery();

          for (const item of action.items) {
            if (item.id) {
               fetch(`https://firestore.googleapis.com/v1/${item.id}?key=${API_KEY}`, { method: 'DELETE' });
            }
          }
        } else if (action.type === 'favorite') {
          if (action.newState) {
            favorites.add(action.url);
          } else {
            favorites.delete(action.url);
          }
          updateHistoryButtons();
          renderGallery();

          try {
            fetch(`https://firestore.googleapis.com/v1/${action.item.id}?updateMask.fieldPaths=favorite&key=${API_KEY}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ fields: { favorite: { booleanValue: action.newState } } })
            });
          } catch (e) {}
        }
      });

      const MAX_SCALE = 6;
      let currentScale = 1;
      let panX = 0;
      let panY = 0;
      let pinchStartDist = 0;
      let startScale = 1;
      let isZoomed = false;

      function areButtonsVisible() {
        return !modalPrevBtn.classList.contains('hidden') || !modalBottomActions.classList.contains('hidden');
      }

      function updateImageTransform(animated = false) {
        if (animated) {
          modalImg.style.transition = `transform var(--transition-speed) var(--transition-easing), opacity var(--transition-speed) var(--transition-easing)`;
        } else {
          modalImg.style.transition = 'none';
        }
        modalImg.style.transform = `translate(${panX}px, ${panY}px) scale(${currentScale})`;
        isZoomed = currentScale > 1.05;
      }

      function resetZoom(animated = true) {
        currentScale = 1;
        panX = 0;
        panY = 0;
        isZoomed = false;
        updateImageTransform(animated);
      }

      function updateModalFavUI() {
        const visible = getVisibleImages();
        if (!visible.length || currentModalIndex < 0) return;
        const isFav = favorites.has(visible[currentModalIndex].url);
        
        if (isFav) {
          modalFavBtn.classList.add('active');
          modalFavBtn.innerHTML = '♥';
        } else {
          modalFavBtn.classList.remove('active');
          modalFavBtn.innerHTML = '♡';
        }
      }

      function openPopupByIndex(index) {
        const visible = getVisibleImages();
        if (!visible.length) return;
        
        resetZoom(false);
        currentModalIndex = (index + visible.length) % visible.length;
        modalImg.src = visible[currentModalIndex].url;
        modalImg.className = 'modal-content';
        
        modalClose.classList.remove('hidden');
        modalSlideshowBar.classList.remove('hidden');
        modalPrevBtn.classList.remove('hidden');
        modalNextBtn.classList.remove('hidden');
        modalBottomActions.classList.remove('hidden');
        updateModalFavUI();
        
        if (!imageModal.classList.contains('open')) {
          history.pushState({ modalOpen: true }, '');
        }
        
        imageModal.classList.add('open');
      }

      function clearTransitionClasses() {
        modalImg.classList.remove('anim-slide-left', 'anim-slide-right', 'anim-fade-out', 'anim-zoom-out');
      }

      function transitionToImage(nextIndex, direction = 'next') {
        const visible = getVisibleImages();
        if (visible.length <= 1 || isTransitioning) return;
        
        const animType = slideshowAnimSelect.value;

        if (animType === 'none') {
          resetZoom(false);
          currentModalIndex = nextIndex;
          modalImg.src = visible[currentModalIndex].url;
          updateModalFavUI();
          return;
        }

        isTransitioning = true;
        modalImg.style.transition = `transform var(--transition-speed) var(--transition-easing), opacity var(--transition-speed) var(--transition-easing)`;

        if (animType === 'slide') {
          modalImg.classList.add(direction === 'next' ? 'anim-slide-left' : 'anim-slide-right');
        } else if (animType === 'fade') {
          modalImg.classList.add('anim-fade-out');
        } else if (animType === 'zoom') {
          modalImg.classList.add('anim-zoom-out');
        }

        setTimeout(() => {
          resetZoom(false);
          currentModalIndex = nextIndex;
          modalImg.src = visible[currentModalIndex].url;
          updateModalFavUI();

          modalImg.style.transition = 'none';
          clearTransitionClasses();

          if (animType === 'slide') {
            modalImg.classList.add(direction === 'next' ? 'anim-slide-right' : 'anim-slide-left');
          } else if (animType === 'fade') {
            modalImg.classList.add('anim-fade-out');
          } else if (animType === 'zoom') {
            modalImg.classList.add('anim-zoom-out');
          }

          void modalImg.offsetWidth;

          modalImg.style.transition = `transform var(--transition-speed) var(--transition-easing), opacity var(--transition-speed) var(--transition-easing)`;
          clearTransitionClasses();
          modalImg.style.transform = '';

          setTimeout(() => {
            isTransitioning = false;
          }, TRANSITION_DURATION_MS);
        }, TRANSITION_DURATION_MS);
      }

      function showNextImage() {
        if (isZoomed || isTransitioning) return;
        const visible = getVisibleImages();
        const nextIdx = (currentModalIndex + 1) % visible.length;
        transitionToImage(nextIdx, 'next');
      }

      function showPrevImage() {
        if (isZoomed || isTransitioning) return;
        const visible = getVisibleImages();
        const prevIdx = (currentModalIndex - 1 + visible.length) % visible.length;
        transitionToImage(prevIdx, 'prev');
      }

      function startSlideshow() {
        isSlideshowPlaying = true;
        slideshowToggleBtn.classList.add('active');
        slideshowIcon.innerHTML = `<svg viewBox="0 0 24 24" width="14" height="14" fill="#ffffff"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>`;

        clearInterval(slideshowTimer);
        const interval = Math.max(parseInt(slideshowTimerSelect.value, 10) || 3000, 1500);
        slideshowTimer = setInterval(() => {
          showNextImage();
        }, interval);
      }

      function stopSlideshow() {
        isSlideshowPlaying = false;
        slideshowToggleBtn.classList.remove('active');
        slideshowIcon.innerHTML = `<svg viewBox="0 0 24 24" width="14" height="14" fill="#ffffff"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`;
        clearInterval(slideshowTimer);
      }

      function toggleSlideshow() {
        if (isSlideshowPlaying) {
          stopSlideshow();
        } else {
          startSlideshow();
        }
      }

      slideshowToggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleSlideshow();
      });

      slideshowTimerSelect.addEventListener('change', () => {
        if (isSlideshowPlaying) {
          startSlideshow();
        }
      });

      slideshowTimerSelect.addEventListener('click', (e) => e.stopPropagation());
      slideshowAnimSelect.addEventListener('click', (e) => e.stopPropagation());

      let dragDistanceMoved = 0;
      modalImg.addEventListener('click', (e) => {
        e.stopPropagation();
        if (dragDistanceMoved > 8) return;

        if (isZoomed) {
          resetZoom(true);
          return;
        }

        modalClose.classList.toggle('hidden');
        modalSlideshowBar.classList.toggle('hidden');
        modalPrevBtn.classList.toggle('hidden');
        modalNextBtn.classList.toggle('hidden');
        modalBottomActions.classList.toggle('hidden');
      });

      let startTouchX = 0;
      let startTouchY = 0;
      let initialPanX = 0;
      let initialPanY = 0;

      function getTouchDistance(touches) {
        const dx = touches[0].clientX - touches[1].clientX;
        const dy = touches[0].clientY - touches[1].clientY;
        return Math.sqrt(dx * dx + dy * dy);
      }

      imageModal.addEventListener('touchstart', (e) => {
        dragDistanceMoved = 0;

        if (e.touches.length === 2) {
          if (areButtonsVisible()) {
            pinchStartDist = 0;
            return;
          }
          pinchStartDist = getTouchDistance(e.touches);
          startScale = currentScale;
          return;
        }

        if (e.touches.length === 1) {
          startTouchX = e.touches[0].clientX;
          startTouchY = e.touches[0].clientY;
          initialPanX = panX;
          initialPanY = panY;
        }
      }, { passive: false });

      imageModal.addEventListener('touchmove', (e) => {
        if (e.touches.length === 2 && pinchStartDist > 0) {
          e.preventDefault();
          if (areButtonsVisible()) return;

          const newDist = getTouchDistance(e.touches);
          const ratio = newDist / pinchStartDist;
          currentScale = Math.min(Math.max(startScale * ratio, 1), MAX_SCALE);
          updateImageTransform(false);
          dragDistanceMoved = 20;
          return;
        }

        if (e.touches.length === 1) {
          const diffX = e.touches[0].clientX - startTouchX;
          const diffY = e.touches[0].clientY - startTouchY;
          dragDistanceMoved = Math.sqrt(diffX * diffX + diffY * diffY);

          if (isZoomed) {
            e.preventDefault();
            panX = initialPanX + diffX;
            panY = initialPanY + diffY;
            updateImageTransform(false);
          } else {
            e.preventDefault();
            if (Math.abs(diffX) >= Math.abs(diffY)) {
              modalImg.style.transform = `translateX(${diffX * 0.75}px)`;
            } else {
              modalImg.style.transform = `translateY(${diffY * 0.75}px)`;
            }
          }
        }
      }, { passive: false });

      imageModal.addEventListener('touchend', (e) => {
        if (e.touches.length === 0) {
          if (currentScale <= 1.05) {
            resetZoom(true);
          } else {
            updateImageTransform(true);
          }

          if (!isZoomed && dragDistanceMoved > 50) {
            const touchEnd = e.changedTouches[0];
            const finalX = (touchEnd ? touchEnd.clientX : 0) - startTouchX;
            const finalY = (touchEnd ? touchEnd.clientY : 0) - startTouchY;

            if (Math.abs(finalX) >= Math.abs(finalY)) {
              if (finalX < 0) showNextImage();
              else showPrevImage();
            } else {
              if (finalY < 0) showNextImage();
              else showPrevImage();
            }
          }
        }
      }, { passive: true });

      let isMouseDown = false;
      let startMouseX = 0;
      let startMouseY = 0;

      modalViewer.addEventListener('mousedown', (e) => {
        isMouseDown = true;
        startMouseX = e.clientX;
        startMouseY = e.clientY;
        initialPanX = panX;
        initialPanY = panY;
        dragDistanceMoved = 0;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isMouseDown || !imageModal.classList.contains('open')) return;
        const diffX = e.clientX - startMouseX;
        const diffY = e.clientY - startMouseY;
        dragDistanceMoved = Math.sqrt(diffX * diffX + diffY * diffY);

        if (isZoomed) {
          panX = initialPanX + diffX;
          panY = initialPanY + diffY;
          updateImageTransform(false);
        } else {
          if (Math.abs(diffX) >= Math.abs(diffY)) {
            modalImg.style.transform = `translateX(${diffX * 0.6}px)`;
          } else {
            modalImg.style.transform = `translateY(${diffY * 0.6}px)`;
          }
        }
      });

      window.addEventListener('mouseup', (e) => {
        if (!isMouseDown) return;
        isMouseDown = false;

        if (isZoomed) {
          updateImageTransform(true);
          return;
        }

        modalImg.style.transform = '';
        if (dragDistanceMoved > 60) {
          const diffX = e.clientX - startMouseX;
          const diffY = e.clientY - startMouseY;

          if (Math.abs(diffX) >= Math.abs(diffY)) {
            if (diffX < 0) showNextImage();
            else showPrevImage();
          } else {
            if (diffY < 0) showNextImage();
            else showPrevImage();
          }
        }
      });

      let isScrollThrottled = false;
      imageModal.addEventListener('wheel', (e) => {
        e.preventDefault();

        if (e.ctrlKey || Math.abs(e.deltaZ || 0) > 0) {
          if (areButtonsVisible()) return;

          const factor = e.deltaY < 0 ? 1.15 : 0.85;
          currentScale = Math.min(Math.max(currentScale * factor, 1), MAX_SCALE);
          if (currentScale <= 1.05) {
            resetZoom(true);
          } else {
            updateImageTransform(true);
          }
          return;
        }

        if (isZoomed || isTransitioning) return;

        if (isScrollThrottled) return;
        const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;

        if (delta > 20) {
          showNextImage();
          isScrollThrottled = true;
          setTimeout(() => { isScrollThrottled = false; }, TRANSITION_DURATION_MS);
        } else if (delta < -20) {
          showPrevImage();
          isScrollThrottled = true;
          setTimeout(() => { isScrollThrottled = false; }, TRANSITION_DURATION_MS);
        }
      }, { passive: false });

      modalNextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        showNextImage();
      });

      modalPrevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        showPrevImage();
      });

      modalInfoBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const visible = getVisibleImages();
        if (visible.length && currentModalIndex >= 0) {
          openInfoOverlay(visible[currentModalIndex]);
        }
      });

      modalFavBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const visible = getVisibleImages();
        if (visible.length && currentModalIndex >= 0) {
          toggleFavorite(visible[currentModalIndex], true);
          updateModalFavUI();
        }
      });

      modalDownloadBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const visible = getVisibleImages();
        if (visible.length && currentModalIndex >= 0) {
          downloadSingleImage(visible[currentModalIndex].url, visible[currentModalIndex].name);
        }
      });

      modalDeleteBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const visible = getVisibleImages();
        if (visible.length && currentModalIndex >= 0) {
          stopSlideshow();
          selectedUrls.clear();
          selectedUrls.add(visible[currentModalIndex].url);
          updateSelectionState();
          imageModal.classList.remove('open');
          
          confirmTitle.textContent = 'Delete Image?';
          confirmOverlay.classList.add('open');
        }
      });

      function closeModal(fromPopState = false) {
        stopSlideshow();
        resetZoom(false);
        clearTransitionClasses();
        imageModal.classList.remove('open');

        if (!fromPopState && history.state && history.state.modalOpen) {
          history.back();
        }
      }

      modalClose.addEventListener('click', closeModal);
      
      imageModal.addEventListener('click', (e) => {
        if (e.target === imageModal && dragDistanceMoved <= 8) {
          if (isZoomed) {
            resetZoom(true);
            return;
          }
          closeModal();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (infoOverlayModal.classList.contains('open')) {
          if (e.key === 'Escape') {
            closeInfoOverlay();
            return;
          }
        }
        if (imageModal.classList.contains('open')) {
          if (e.key === ' ' || e.code === 'Space') {
            e.preventDefault();
            toggleSlideshow();
          } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            if (!isZoomed) showNextImage();
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            if (!isZoomed) showPrevImage();
          }
        }
        if (e.key === 'Escape') {
          closeModal();
          confirmOverlay.classList.remove('open');
        }
      });

      fetch(FIRESTORE_QUERY, { cache: 'no-store' })
        .then(res => res.json())
        .then(data => {
          loadingMessage.style.display = 'none';
          const docs = data.documents || [];

          if (docs.length === 0) {
            gridContainer.innerHTML = '<div style="text-align: center; grid-column: 1/-1; color: var(--text-muted); padding: 50px;">No images in cloud library.</div>';
            return;
          }
          
          allImages = docs.map((doc, index) => {
            const fields = doc.fields || {};
            const url = fields.str ? fields.str.stringValue : '';
            const favorite = fields.favorite ? fields.favorite.booleanValue : false;
            let tags = fields.tags?.arrayValue?.values?.map(v => v.stringValue) || [];

            if (!tags.includes(DEFAULT_TAG)) {
              tags.unshift(DEFAULT_TAG);
            }

            if (favorite) favorites.add(url);
            tags.forEach(t => allTags.add(t));

            return {
              id: doc.name, 
              url: url,
              name: sanitizeFilename(url), 
              originalIndex: index,
              tags: tags
            };
          });

          renderSidebarTags();
          renderGallery();
        })
        .catch(err => {
          loadingMessage.textContent = 'Could not fetch gallery items.';
        });

        const galleryTitleBtn = document.getElementById('galleryTitleBtn');

        galleryTitleBtn.addEventListener('click', () => {
          staticTop.classList.remove('header-hidden', 'header-scrolled');
          headerRevealBtn.classList.remove('visible');

          mainContent.scrollTo({
            top: 0,
            behavior: 'auto'
          });
        });

        window.addEventListener('popstate', (e) => {
          if (infoOverlayModal.classList.contains('open')) {
            closeInfoOverlay();
          }
          if (imageModal.classList.contains('open')) {
            closeModal(true);
          }
          if (confirmOverlay.classList.contains('open')) {
            confirmOverlay.classList.remove('open');
          }
        });
    </script>
</body>
</html>
