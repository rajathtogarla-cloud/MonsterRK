      function sanitizeFilename(url, suggestedName) {
        if (suggestedName && suggestedName.trim().length > 0) {
          let name = suggestedName.trim().replace(/[/\\?%*:|"<>]/g, '-');
          if (!/\.(jpg|jpeg|png|webp|gif|svg|bmp)$/i.test(name)) name += '.jpg';
          return name;
        }
        try {
          const parsed = new URL(url);
          let filename = parsed.pathname.substring(parsed.pathname.lastIndexOf('/') + 1);
          if (filename && filename.includes('.')) {
            return decodeURIComponent(filename.replace(/[/\\?%*:|"<>]/g, '-'));
          }
        } catch (e) {}
        return `image_${Date.now()}.jpg`;
      }

      async function triggerSafeFileDownload(blob, filename) {
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.style.display = 'none';
        link.href = url;
        link.download = filename;

        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          URL.revokeObjectURL(url);
        }, 1500);
      }

      async function downloadSingleImage(url, name) {
        showNotification('Downloading image...');
        const filename = sanitizeFilename(url, name);
        try {
          const response = await fetch(url, { referrerPolicy: 'no-referrer', mode: 'cors' });
          if (!response.ok) throw new Error('CORS or Network error');
          const blob = await response.blob();
          await triggerSafeFileDownload(blob, filename);
          showNotification('Download finished!');
        } catch (err) {
          const link = document.createElement('a');
          link.href = url;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          showNotification('Opening image in a new tab.');
        }
      }

      async function downloadZipArchive(itemsToDownload, zipFilename = 'gallery-collection.zip') {
        if (!itemsToDownload || itemsToDownload.length === 0) return;
        if (itemsToDownload.length === 1) {
          downloadSingleImage(itemsToDownload[0].url, itemsToDownload[0].name);
          return;
        }

        showNotification(`Archiving ${itemsToDownload.length} files...`, false, 6000);
        const zip = new JSZip();
        let successCount = 0;

        const downloadPromises = itemsToDownload.map(async (item, i) => {
          const filename = sanitizeFilename(item.url, item.name || `image_${i + 1}`);
          try {
            const resp = await fetch(item.url, { referrerPolicy: 'no-referrer' });
            if (!resp.ok) throw new Error('Fetch error');
            const blob = await resp.blob();
            zip.file(filename, blob);
            successCount++;
          } catch (error) { }
        });

        await Promise.allSettled(downloadPromises);

        if (successCount === 0) {
          showNotification('Network limitations prevented download.');
          return;
        }

        showNotification('Compiling zip archive...');
        const zipBlob = await zip.generateAsync({ type: 'blob', mimeType: 'application/zip' });
        await triggerSafeFileDownload(zipBlob, zipFilename);
        showNotification(`Exported ${successCount} images.`);
      }

