          setTimeout(() => {
            lastScrollY = mainContent.scrollTop;
            ignoreScrollEvents = false;
          }, 60);
        });
      }

      selectAllTick.parentElement.addEventListener('click', () => {
        const visible = getVisibleImages();
        allSelectedState = !allSelectedState;
        
